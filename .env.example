# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Tutor, Question forge (any tool-calling capable model)
OPENAI_MODEL=gpt-4.1-mini

# Exam analysis: reads PDFs/photos and decides the grade, a stronger model is more reliable
OPENAI_ANALYSIS_MODEL=gpt-4.1

# Flashcard deck builder (defaults to OPENAI_MODEL)
# OPENAI_FLASHCARD_MODEL=gpt-4.1

# Embeddings used to index the course material
OPENAI_EMBED_MODEL=text-embedding-3-small

PORT=3000
